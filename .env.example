# Claude API — tylko po stronie serwera. Skopiuj do .env.local i uzupełnij.
ANTHROPIC_API_KEY=

# Upstash Redis — rate limit dla „Wklej własnego maila”.
# Bez tych zmiennych triage na żywo jest wyłączony, reszta demo działa.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limity triage na żywo (opcjonalne)
LIVE_LIMIT_PER_IP_PER_DAY=10
LIVE_LIMIT_GLOBAL_PER_DAY=200

# Sekret dla POST /api/triage (n8n). Wygeneruj np.: openssl rand -hex 32
TRIAGE_API_SECRET=
