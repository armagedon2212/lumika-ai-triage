# Model do triage na żywo (i precompute). Wszystkie klucze tylko po stronie serwera.
# Skopiuj do .env.local i uzupełnij JEDEN z kluczy.
#   anthropic — Claude Haiku 5.5 przez Claude API (płatne, wymaga środków na koncie)
#   gemini    — Gemini Flash-Lite przez Gemini API (darmowy plan, niskie limity)
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
# Klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcjonalnie inny model Gemini (domyślnie gemini-3.5-flash-lite)
GEMINI_MODEL=

# Upstash Redis — rate limit dla „Wklej własnego maila”.
# Produkcja: bez tych zmiennych triage na żywo jest wyłączony, reszta demo działa.
# Lokalnie (npm run dev) bez Upstash działa limiter w pamięci.
# Integracja Upstash z Vercel Marketplace ustawia zamiennie KV_REST_API_URL / KV_REST_API_TOKEN — też działają.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limity triage na żywo (opcjonalne)
LIVE_LIMIT_PER_IP_PER_DAY=10
LIVE_LIMIT_GLOBAL_PER_DAY=200

# Sekret dla POST /api/triage (n8n). Wygeneruj np.: openssl rand -hex 32
TRIAGE_API_SECRET=
